{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android",
  "description": "Capabilities for the Android build (no dialog/shell plugins)",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "core:path:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-stat",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" },
        { "path": "/storage/emulated/0/**" },
        { "path": "/sdcard/**" }
      ]
    }
  ]
}
